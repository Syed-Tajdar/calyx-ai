# ── Ingestion (Go) ──────────────────────────────────────────
INGESTION_PORT=8080
REDIS_URL=redis://localhost:6379
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC_PINGS=callloom.pings.v1
DATABASE_URL=postgres://callloom:callloom_dev@localhost:5432/callloom?sslmode=disable
ANI_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
DEDUP_TTL_HOURS=24
MAX_BODY_BYTES=1048576

# ── Consumer (Go) ───────────────────────────────────────────
CONSUMER_PORT=8081
CLICKHOUSE_ADDR=localhost:9000
CLICKHOUSE_DB=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=callloom_dev
KAFKA_CONSUMER_GROUP=callloom-consumer
BATCH_SIZE=500
BATCH_FLUSH_MS=5000

# ── API (NestJS) ────────────────────────────────────────────
API_PORT=3000
JWT_SECRET=callloom_dev_jwt_secret_min_32_chars_long
CLICKHOUSE_URL=http://default:callloom_dev@localhost:8123

# ── Web (Next.js) ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000

# ── External APIs (never commit real values) ────────────────
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ENROLLHERE_API_KEY=
WHITEPAGES_API_KEY=
