# ── Global Phase 2 ────────────────────────────────────────────
MOCK_MODE=true
MOCK_EMITTER_ENABLED=true

# ── Ingestion (Go) ──────────────────────────────────────────
INGESTION_PORT=8080
REDIS_URL=redis://localhost:6379
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC_PINGS=callloom.pings.v1
DATABASE_URL=postgres://callloom_api:api_dev@localhost:5432/callloom?sslmode=disable
INGESTION_DATABASE_URL=postgres://callloom_ingestion:ingestion_dev@localhost:5432/callloom?sslmode=disable
RINGBA_WEBHOOK_SECRET=dev_ringba_hmac_secret_change_me
ANI_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
DEDUP_TTL_HOURS=24
MAX_BODY_BYTES=1048576

# ── Consumer (Go) ───────────────────────────────────────────
CONSUMER_PORT=8081
CLICKHOUSE_ADDR=localhost:9000
CLICKHOUSE_DB=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=callloom_dev
KAFKA_CONSUMER_GROUP=callloom-consumer
BATCH_SIZE=500
BATCH_FLUSH_MS=5000

# ── Scoring (Go) ────────────────────────────────────────────
SCORING_PORT=8082
KAFKA_TOPIC_CALL_TRANSCRIPT_READY=callloom.calls.call_transcript_ready.v1
KAFKA_TOPIC_CALL_SCORED=callloom.calls.call_scored.v1
KAFKA_TOPIC_SCORING_DLQ=callloom.scoring.dlq.v1
KAFKA_SCORING_GROUP=callloom-scoring
KAFKA_MOCK_EMITTER_GROUP=callloom-scoring-mock-emitter
TRANSCRIPTION_PROVIDER=mock
AI_PROVIDER=mock
RECORDING_SOURCE=mock

# ── Enrichment (Go) ─────────────────────────────────────────
ENRICHMENT_PORT=8083
KAFKA_TOPIC_ENRICHMENT_DLQ=callloom.enrichment.dlq.v1
KAFKA_ENRICHMENT_GROUP=callloom-enrichment
ENRICHMENT_PROVIDER=mock
ENRICHMENT_CACHE_TTL_HOURS=24

# ── API (NestJS) ────────────────────────────────────────────
API_PORT=3000
JWT_SECRET=callloom_dev_jwt_secret_min_32_chars_long
CLICKHOUSE_URL=http://default:callloom_dev@localhost:8123
ADSPEND_SOURCE=mock
NOTIFICATION_CHANNEL=mock
DEEPGRAM_CALLBACK_SECRET=dev_deepgram_callback_secret_change_me

# ── Web (Next.js) ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000

# ── External APIs (never commit real values) ────────────────
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ENROLLHERE_API_KEY=
WHITEPAGES_API_KEY=
