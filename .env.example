# ── Global Phase 2 / 3 ────────────────────────────────────────
MOCK_MODE=true
MOCK_EMITTER_ENABLED=true
SINGLE_TENANT_MODE=false

# ── Provider config (Phase 3 Step 1b) ───────────────────────
PROVIDERCONFIG_PORT=8084
PROVIDERCONFIG_URL=http://localhost:8084
PROVIDER_CATALOG_PATH=shared/providers/catalog.json
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ATTRIBUTION_PROVIDER=mock
DNC_PROVIDER=mock
LLM_PROVIDER=mock

# ── Ingestion (Go) ──────────────────────────────────────────
INGESTION_PORT=8080
REDIS_URL=redis://localhost:6379
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC_PINGS=callloom.pings.v1
DATABASE_URL=postgres://callloom_api:api_dev@localhost:5432/callloom?sslmode=disable
INGESTION_DATABASE_URL=postgres://callloom_ingestion:ingestion_dev@localhost:5432/callloom?sslmode=disable
RINGBA_WEBHOOK_SECRET=dev_ringba_hmac_secret_change_me
ANI_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
DEDUP_TTL_HOURS=24
MAX_BODY_BYTES=1048576

# ── Consumer (Go) ───────────────────────────────────────────
CONSUMER_PORT=8081
CLICKHOUSE_ADDR=localhost:9000
CLICKHOUSE_DB=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=callloom_dev
KAFKA_CONSUMER_GROUP=callloom-consumer
BATCH_SIZE=500
BATCH_FLUSH_MS=5000

# ── Scoring (Go) ────────────────────────────────────────────
SCORING_PORT=8082
KAFKA_TOPIC_CALL_TRANSCRIPT_READY=callloom.calls.call_transcript_ready.v1
KAFKA_TOPIC_CALL_SCORED=callloom.calls.call_scored.v1
KAFKA_TOPIC_SCORING_DLQ=callloom.scoring.dlq.v1
KAFKA_SCORING_GROUP=callloom-scoring
KAFKA_MOCK_EMITTER_GROUP=callloom-scoring-mock-emitter
TRANSCRIPTION_PROVIDER=mock
AI_PROVIDER=mock
RECORDING_SOURCE=mock

# ── Compliance intelligence (Phase 3 Step 2) ────────────────
COMPLIANCE_PORT=8085
PROVIDERCONFIG_URL=http://localhost:8084
KAFKA_TOPIC_COMPLIANCE_RISK_SCORED=callloom.compliance.risk_scored.v1
KAFKA_TOPIC_COMPLIANCE_VIOLATION=callloom.compliance.violation_detected.v1
KAFKA_TOPIC_COMPLIANCE_DLQ=callloom.compliance.dlq.v1
KAFKA_COMPLIANCE_GROUP=callloom-compliance
COMPLIANCE_DEDUP_TTL_HOURS=24

# ── Ask AI (Phase 3 Step 3) ─────────────────────────────────
ASK_AI_PORT=8086
ASK_AI_URL=http://localhost:8086
ASK_AI_TOKEN_BUDGET_DAILY=100000
ASK_AI_QUERY_TIMEOUT_SEC=10
ASK_AI_MAX_ROWS=100

# ── Ad attribution (Phase 3 Step 4) ─────────────────────────
ATTRIBUTION_PORT=8087
ATTRIBUTION_MOCK_BRIDGE=true
KAFKA_TOPIC_CONVERSIONS=callloom.conversions.v1
KAFKA_TOPIC_ATTRIBUTION_ATTRIBUTED=callloom.attribution.attributed.v1
KAFKA_TOPIC_ATTRIBUTION_DLQ=callloom.attribution.dlq.v1
KAFKA_ATTRIBUTION_GROUP=callloom-attribution
KAFKA_ATTRIBUTION_BRIDGE_GROUP=callloom-attribution-bridge
ATTRIBUTION_DEDUP_TTL_HOURS=24
ATTRIBUTION_FIRE_MAX_RETRIES=3

ENRICHMENT_PORT=8083
KAFKA_TOPIC_ENRICHMENT_DLQ=callloom.enrichment.dlq.v1
KAFKA_ENRICHMENT_GROUP=callloom-enrichment
ENRICHMENT_PROVIDER=mock
ENRICHMENT_CACHE_TTL_HOURS=24

# ── API (NestJS) ────────────────────────────────────────────
API_PORT=3000
JWT_SECRET=callloom_dev_jwt_secret_min_32_chars_long
CLICKHOUSE_URL=http://default:callloom_dev@localhost:8123
ADSPEND_SOURCE=mock
NOTIFICATION_CHANNEL=mock
DEEPGRAM_CALLBACK_SECRET=dev_deepgram_callback_secret_change_me
REDIS_URL=redis://localhost:6379

# ── Web (Next.js) ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000

# ── External APIs (never commit real values) ────────────────
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ENROLLHERE_API_KEY=
WHITEPAGES_API_KEY=
