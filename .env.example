# ── Ingestion (Go) ──────────────────────────────────────────
INGESTION_PORT=8080
REDIS_URL=redis://localhost:6379
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC_PINGS=callloom.pings.v1

# ── Consumer (Go) ───────────────────────────────────────────
CONSUMER_PORT=8081
CLICKHOUSE_DSN=clickhouse://localhost:9000/default
KAFKA_CONSUMER_GROUP=callloom-consumer
BATCH_SIZE=500
BATCH_FLUSH_MS=5000

# ── API (NestJS) ────────────────────────────────────────────
API_PORT=3000
DATABASE_URL=postgres://callloom:callloom_dev@localhost:5432/callloom
REDIS_URL=redis://localhost:6379
JWT_PUBLIC_KEY_PATH=

# ── Web (Next.js) ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000

# ── External APIs (never commit real values) ────────────────
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ENROLLHERE_API_KEY=
WHITEPAGES_API_KEY=

# ── Platform webhooks ───────────────────────────────────────
RINGBA_WEBHOOK_SECRET=
RETREAVER_WEBHOOK_SECRET=
