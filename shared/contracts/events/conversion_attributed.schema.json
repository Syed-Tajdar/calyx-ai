{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConversionAttributed",
  "type": "object",
  "required": ["tenant_id", "event_id", "call_id", "platform", "status", "attributed_at"],
  "properties": {
    "tenant_id": { "type": "string", "format": "uuid" },
    "event_id": { "type": "string", "minLength": 1 },
    "call_id": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "maxLength": 32 },
    "click_id": { "type": "string", "maxLength": 256 },
    "revenue": { "type": "number" },
    "status": { "type": "string", "enum": ["fired", "failed"] },
    "http_status": { "type": "integer", "minimum": 0 },
    "attributed_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
