# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_WS_URL
ARG NEXT_PUBLIC_MOCK_MODE=true
ARG NEXT_PUBLIC_RETREAVER_CALL_URL_PATTERN=https://retreaver.com/calls/{id}
ARG NEXT_PUBLIC_FEATURE_ASK_AI=false
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL
ENV NEXT_PUBLIC_MOCK_MODE=$NEXT_PUBLIC_MOCK_MODE
ENV NEXT_PUBLIC_RETREAVER_CALL_URL_PATTERN=$NEXT_PUBLIC_RETREAVER_CALL_URL_PATTERN
ENV NEXT_PUBLIC_FEATURE_ASK_AI=$NEXT_PUBLIC_FEATURE_ASK_AI

RUN test -n "$NEXT_PUBLIC_API_URL" && test -n "$NEXT_PUBLIC_WS_URL"

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# Runtime stage
FROM node:20-alpine

WORKDIR /app

ENV NODE_ENV=production

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_WS_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/next.config.mjs ./

EXPOSE 3000

USER node

CMD ["npm", "start"]
