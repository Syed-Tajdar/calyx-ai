# Copy to a git-ignored .env on the server. Leave empty here.
# Compose still has a dev default for each variable so a laptop without this file keeps working.
# On the server, generate each value with openssl rand -hex 32 and chmod 600 the file.

# Postgres superuser (migrate). Existing volume needs ALTER ROLE, not just this variable.
POSTGRES_PASSWORD=
# Role callloom_api
POSTGRES_API_PASSWORD=
# Role callloom_ingestion
POSTGRES_INGESTION_PASSWORD=
# Role callloom_sync
POSTGRES_SYNC_PASSWORD=

# ClickHouse user default. Existing volume needs ALTER USER.
CLICKHOUSE_PASSWORD=

# Signs session cookies. Changing it logs everyone out. It does not change the user password.
JWT_SECRET=
# Encrypts integrations.api_credentials_blob. Losing it makes stored platform keys unreadable.
CREDENTIAL_ENCRYPTION_KEY=
# Encrypts caller numbers and call_key ciphertext.
ANI_ENCRYPTION_KEY=
# Shared by api and platform-sync for convert/void forwarding.
WRITEBACK_INTERNAL_TOKEN=
# Deepgram callback check. Required when MOCK_MODE=false.
DEEPGRAM_CALLBACK_SECRET=

# Redis requirepass. Every REDIS_URL must use the same value.
REDIS_PASSWORD=

# production on the server. development on a laptop.
APP_ENV=
# https://calyx.ridgerisemedia.com on the server.
WEB_ORIGINS=
# Leave empty. The site is one host.
COOKIE_DOMAIN=
# Docker bridge gateway that nginx uses to reach the API.
TRUSTED_PROXIES=

# false on the server until a live write is approved.
WRITEBACK_ENABLED=

# v2 Phase 2A — Ask AI on numbers (OpenAI). All off by default.
# API flag (runtime) and web flag (build time: rebuild the web image after changing it).
FEATURE_ASK_AI=
NEXT_PUBLIC_FEATURE_ASK_AI=
# Server only. Never commit a real key. Production refuses to start with FEATURE_ASK_AI=true and no key.
OPENAI_API_KEY=
OPENAI_MODEL=
# Hard daily cap per tenant (Eastern day). Default 300000.
ASK_AI_TOKEN_BUDGET_DAILY=
# false on the server. true keeps local mock stubs. Live integrations still follow sync_mode.
MOCK_MODE=
# Local default true. Forced off when APP_ENV=production. Demo rows stay in the database.
DEMO_MODE_ENABLED=
# Set to intelligence for a laptop that should start the Chapter 2 services. Leave empty on the server.
COMPOSE_PROFILES=
