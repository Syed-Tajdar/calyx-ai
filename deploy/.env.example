# Copy to a git-ignored .env on the server. Leave empty here.
# Compose still has a dev default for each variable so a laptop without this file keeps working.
# On the server, generate each value with openssl rand -hex 32 and chmod 600 the file.

# Postgres superuser (migrate). Existing volume needs ALTER ROLE, not just this variable.
POSTGRES_PASSWORD=
# Role callloom_api
POSTGRES_API_PASSWORD=
# Role callloom_ingestion
POSTGRES_INGESTION_PASSWORD=
# Role callloom_sync
POSTGRES_SYNC_PASSWORD=

# ClickHouse user default. Existing volume needs ALTER USER.
CLICKHOUSE_PASSWORD=

# Signs session cookies. Changing it logs everyone out. It does not change the user password.
JWT_SECRET=
# Encrypts integrations.api_credentials_blob. Losing it makes stored platform keys unreadable.
CREDENTIAL_ENCRYPTION_KEY=
# Encrypts caller numbers and call_key ciphertext.
ANI_ENCRYPTION_KEY=
# Shared by api and platform-sync for convert/void forwarding.
WRITEBACK_INTERNAL_TOKEN=
# Deepgram callback check. Required when MOCK_MODE=false.
DEEPGRAM_CALLBACK_SECRET=

# Redis requirepass. Every REDIS_URL must use the same value.
REDIS_PASSWORD=

# production on the server. development on a laptop.
APP_ENV=
# https://calyx.ridgerisemedia.com on the server.
WEB_ORIGINS=
# Leave empty. The site is one host.
COOKIE_DOMAIN=
# Docker bridge gateway that nginx uses to reach the API.
TRUSTED_PROXIES=

# false on the server until a live write is approved.
WRITEBACK_ENABLED=

# v2 Phase 2A — Ask AI on numbers (OpenAI). All off by default.
# API flag (runtime) and web flag (build time: rebuild the web image after changing it).
FEATURE_ASK_AI=
NEXT_PUBLIC_FEATURE_ASK_AI=
# Later v2 phases (all off; API runtime flag + web build-time flag):
FEATURE_TRANSCRIPTION=
NEXT_PUBLIC_FEATURE_TRANSCRIPTION=
FEATURE_QA=
NEXT_PUBLIC_FEATURE_QA=
FEATURE_WORKFLOWS=
NEXT_PUBLIC_FEATURE_WORKFLOWS=
FEATURE_ASK_AI_TRANSCRIPTS=
# Server only. Never commit a real key. Production refuses to start with FEATURE_ASK_AI=true and no key.
OPENAI_API_KEY=
OPENAI_MODEL=
# Hard daily cap per tenant (Eastern day). Default 300000.
ASK_AI_TOKEN_BUDGET_DAILY=
# v2 Phase 2D — Workflows (alert -> action). Needs FEATURE_WORKFLOWS / NEXT_PUBLIC_FEATURE_WORKFLOWS above.
# Kill switch for publisher pause (API and platform-sync). false/empty = rules alert and suggest, never pause.
WORKFLOW_ACTIONS_ENABLED=
# true only after the Ringba sandbox proof (PATCH enabled:false == UI pause). Off = Ringba gets a link, no write.
WORKFLOW_RINGBA_PAUSE_VERIFIED=
# Automatic pauses per tenant per Eastern day. Default 3.
WORKFLOW_MAX_AUTO_PAUSES_DAILY=
# v2 Phase 2B — Transcription (Deepgram) + recording archive. Needs FEATURE_TRANSCRIPTION /
# NEXT_PUBLIC_FEATURE_TRANSCRIPTION above. Server only; never commit a real key. With the flag on, production
# refuses to start without DEEPGRAM_API_KEY and ARCHIVE_S3_ENDPOINT, _BUCKET, _KEY_ID, _SECRET_KEY (REGION optional).
DEEPGRAM_API_KEY=
# Converted calls only (owner Q5). true = also should-have-converted calls.
TRANSCRIBE_SHOULD_CONVERT=false
# Hard stop per tenant per Eastern day. Default 800.
TRANSCRIBE_DAILY_MINUTES_CAP=
TRANSCRIBE_MIN_SECONDS=
# Private bucket (Backblaze B2 preferred), application key limited to this one bucket, SSE on.
ARCHIVE_S3_ENDPOINT=
ARCHIVE_S3_REGION=
ARCHIVE_S3_BUCKET=
ARCHIVE_S3_KEY_ID=
ARCHIVE_S3_SECRET_KEY=
# Archive retention in months. Default 24 (owner decision).
RECORDING_RETENTION_MONTHS=
# Alert email (SMTP). Off while SMTP_HOST is empty. Production refuses SMTP_HOST without a real SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Comma-separated recipients.
ALERT_EMAIL_TO=
# false on the server. true keeps local mock stubs. Live integrations still follow sync_mode.
MOCK_MODE=
# Local default true. Forced off when APP_ENV=production. Demo rows stay in the database.
DEMO_MODE_ENABLED=
# Set to intelligence for a laptop that should start the Chapter 2 services. Leave empty on the server.
COMPOSE_PROFILES=
